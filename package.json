{
  "name": "da5h",
  "version": "1.0.0",
  "private": true,
  "description": "DA5H - infrastructure dashboard with Lockdown as its first module",
  "type": "module",
  "author": "Imran Remtulla",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "blocker": "node src/lockdown/blocker.mjs",
